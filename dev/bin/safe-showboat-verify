#!/usr/bin/env bash
# safe-showboat-verify — run `showboat verify` against one or more walkthroughs
# inside a throwaway git worktree, so any contamination produced by verify
# (see PRD 00135) lands in the worktree, not on the active checkout.
#
# Background: showboat v0.6.1 `verify` re-executes a walkthrough's bash blocks
# in the caller's cwd. Walkthroughs that omit `cd /tmp/...` and rely on the
# original `--workdir` flag (not recorded in the markdown) cause the blocks
# to run at project root, producing real commits on master.

set -euo pipefail

usage() {
  cat <<EOF
Usage: dev/bin/safe-showboat-verify <walkthrough> [<walkthrough>...]

Runs showboat verify against each walkthrough inside a temporary git worktree
that is removed on exit. Exit code is 0 if all walkthroughs verify cleanly,
1 if any verify reports diffs OR the wrapper hits an internal failure during
verify, 2 on usage / setup error (bad arg, walkthrough not found, worktree
add failed). Inspect stdout/stderr to disambiguate "verify reports diffs"
from "wrapper failed during verify".

Walkthrough paths can be absolute or relative to the project root.
EOF
  exit 2
}

if [[ $# -lt 1 ]]; then
  usage
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  usage
fi

# Fail fast if showboat is not on PATH. Without this guard, the wrapper would
# still set up a worktree, then `showboat verify` would fail with "command
# not found", and the wrapper would exit 1 (verify failure). The regression
# test (dev/bin/showboat-verify-no-contamination-test.sh) treats exit 0/1 as
# "wrapper ran" and only the post-state assertions fire — those pass when
# nothing executed, so a missing showboat would let the test claim "no
# contamination" without ever exercising the verify path. Exit 2 routes the
# regression test into its `>= 2` branch ("wrapper failed before verify ran;
# test inconclusive") and surfaces the real cause.
if ! command -v showboat >/dev/null 2>&1; then
  echo "error: showboat binary not found on PATH" >&2
  echo "       install with: uv tool install showboat (or pipx install showboat)" >&2
  exit 2
fi

# `git rev-parse` exits non-zero when not in a repo. With `set -e` that aborts
# the script with git's own "fatal: not a git repository" message, so we don't
# need an extra empty-string check here.
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Resolve absolute paths for every input before touching anything.
ABSOLUTE_PATHS=()
for w in "$@"; do
  if [[ "$w" = /* ]]; then
    ABS="$w"
  else
    ABS="${REPO_ROOT}/${w}"
  fi
  if [[ ! -f "$ABS" ]]; then
    echo "error: walkthrough not found: $ABS" >&2
    exit 2
  fi
  ABSOLUTE_PATHS+=("$ABS")
done

# Throwaway worktree path. Random suffix keeps parallel invocations safe.
SUFFIX="$(date +%s)-$$"
WORKTREE="${REPO_ROOT}/dev/local/worktrees/showboat-verify-${SUFFIX}"

cleanup() {
  # Best-effort cleanup. The worktree may already be partially removed if a
  # previous step failed; ignore errors so the trap never masks the real exit.
  # Idempotent — safe to call from EXIT and from a signal handler in the same
  # invocation.
  if [[ -d "$WORKTREE" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKTREE" 2>/dev/null || true
    rm -rf "$WORKTREE" 2>/dev/null || true
  fi
}
# EXIT trap covers normal exit (success, failure, set -e abort).
# INT / TERM traps cleanup AND exit explicitly — without the explicit exit,
# bash continues past the trap, and the next loop iteration would `mkdir -p`
# a non-worktree path then run `showboat verify` in a directory whose `.git`
# walks up to the main repo, defeating this wrapper's whole purpose.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

mkdir -p "${REPO_ROOT}/dev/local/worktrees"
git -C "$REPO_ROOT" worktree add --detach "$WORKTREE" >/dev/null

# dev/local/ is gitignored, so the worktree won't have walkthroughs. Copy each
# input into the worktree under its original relative path so that any other
# files the walkthrough references (e.g. fixtures) still resolve.
mkdir -p "${WORKTREE}/dev/local/walkthroughs"

PASSED=0
FAILED=0
FAILED_PATHS=()
INDEX=0

# Each input gets its own per-index subdir so two walkthroughs with the same
# basename (e.g. nested under different parent dirs) don't clobber each other.
for ABS in "${ABSOLUTE_PATHS[@]}"; do
  INDEX=$((INDEX + 1))
  BASENAME="$(basename "$ABS")"
  REL_DIR="dev/local/walkthroughs/in-${INDEX}"
  mkdir -p "${WORKTREE}/${REL_DIR}"
  COPY="${WORKTREE}/${REL_DIR}/${BASENAME}"
  cp "$ABS" "$COPY"

  # Run verify from inside the worktree so any contamination lands there.
  if ( cd "$WORKTREE" && showboat verify "${REL_DIR}/${BASENAME}" ); then
    PASSED=$((PASSED + 1))
  else
    FAILED=$((FAILED + 1))
    FAILED_PATHS+=("$ABS")
  fi
done

TOTAL=$((PASSED + FAILED))
echo "safe-showboat-verify: ${TOTAL} walkthroughs verified (passed: ${PASSED}, failed: ${FAILED})"
if [[ $FAILED -gt 0 ]]; then
  echo "failed walkthroughs:"
  for p in "${FAILED_PATHS[@]}"; do
    echo "  - $p"
  done
  exit 1
fi
exit 0
